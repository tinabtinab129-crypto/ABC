--// ============================================================
--// DEVICE ID + ไฟล์เก็บสถานะ
--// ============================================================
local DEVICE_FILE  = "ABANG_HUB_device.txt"      -- เก็บ Device ID
local BIND_FILE    = "ABANG_HUB_bindings.txt"    -- เก็บ key|deviceID
local USED_FILE    = "ABANG_HUB_used.txt"        -- เก็บ key ที่ใช้แล้ว

--// สร้าง/โหลด Device ID (ไม่ซ้ำต่อเครื่อง)
local function getDeviceId()
    if not (readfile and writefile and isfile) then
        return "unknown_device"
    end
    if isfile(DEVICE_FILE) then
        local ok, data = pcall(readfile, DEVICE_FILE)
        if ok and data and #data > 0 then
            return data:gsub("%s+", "")
        end
    end
    -- สร้างใหม่
    local newId = tostring(os.time()) .. "_" .. tostring(math.random(100000, 999999)) .. "_" .. tostring(math.random(100000, 999999))
    pcall(writefile, DEVICE_FILE, newId)
    return newId
end

local DeviceID = getDeviceId()

--// โหลด bindings (key|deviceID)
local function loadBindings()
    local map = {}   -- key -> deviceID
    if readfile and isfile and isfile(BIND_FILE) then
        local ok, data = pcall(readfile, BIND_FILE)
        if ok and data then
            for line in data:gmatch("[^\r\n]+") do
                local key, dev = line:match("^(.-)|(.+)$")
                if key and dev then
                    map[key:gsub("%s+", "")] = dev:gsub("%s+", "")
                end
            end
        end
    end
    return map
end

local function saveBinding(key, devId)
    if appendfile then
        pcall(appendfile, BIND_FILE, key .. "|" .. devId .. "\n")
    end
end

local Bindings = loadBindings()

--// โหลด used
local function loadUsed()
    local used = {}
    if readfile and isfile and isfile(USED_FILE) then
        local ok, data = pcall(readfile, USED_FILE)
        if ok and data then
            for line in data:gmatch("[^\r\n]+") do
                used[line:gsub("%s+", "")] = true
            end
        end
    end
    return used
end
local UsedKeys = loadUsed()

--// ตรวจว่าเครื่องนี้ผูกคีย์อะไรไว้แล้วหรือยัง
local function findBoundKeyForDevice()
    for key, dev in pairs(Bindings) do
        if dev == DeviceID then
            return key
        end
    end
    return nil
end

