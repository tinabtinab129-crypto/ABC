local unlocked = false

local function unlockNow(reason)
    unlocked = true
    KeyStatus.TextColor3 = Color3.fromRGB(0, 255, 0)
    KeyStatus.Text = reason or "คีย์ถูกต้อง! กำลังโหลด..."
    task.wait(0.5)
    KeyGui:Destroy()
    buildMainUI()
end

--// ขั้นแรก: ตรวจว่าเครื่องนี้เคยผูกคีย์ไว้แล้วหรือยัง
local boundKey = findBoundKeyForDevice()
if boundKey then
    -- เครื่องนี้เคยผูกคีย์ → เข้าได้เลย ไม่ต้องใส่
    KeyBox.Text = boundKey
    KeyBox.TextEditable = false
    KeyBtn.Text = "เข้าใช้งาน"
    KeySub.Text = "เครื่องนี้ผูกคีย์แล้ว: " .. boundKey
    KeyStatus.TextColor3 = Color3.fromRGB(0, 255, 0)
    KeyStatus.Text = "เครื่องนี้เคยใส่คีย์แล้ว กำลังเข้า..."

    task.spawn(function()
        task.wait(0.8)
        unlockNow("ยินดีต้อนรับกลับ! (ผูกคีย์แล้ว)")
    end)
else
    -- ยังไม่เคยผูก → ให้ใส่คีย์
    local function tryUnlock()
        if unlocked then return end
        local input = (KeyBox.Text or ""):gsub("^%s+", ""):gsub("%s+$", "")

        if input == "" then
            KeyStatus.TextColor3 = Color3.fromRGB(255, 80, 80)
            KeyStatus.Text = "กรุณาใส่คีย์"
            return
        end

        if not VALID_KEYS[input] then
            KeyStatus.TextColor3 = Color3.fromRGB(255, 80, 80)
            KeyStatus.Text = "คีย์ไม่ถูกต้อง"
            KeyBox.Text = ""
            return
        end

        -- คีย์นี้ถูกเครื่องอื่นใช้ไปแล้วหรือยัง
        if Bindings[input] and Bindings[input] ~= DeviceID then
            KeyStatus.TextColor3 = Color3.fromRGB(255, 80, 80)
            KeyStatus.Text = "คีย์นี้ถูกเครื่องอื่นใช้แล้ว"
            KeyBox.Text = ""
            return
        end

        -- ผ่าน → ผูกคีย์กับเครื่องนี้
        Bindings[input] = DeviceID
        saveBinding(input, DeviceID)
        UsedKeys[input] = true
        if appendfile then pcall(appendfile, USED_FILE, input .. "\n") end

        unlockNow("คีย์ถูกต้อง! ผูกกับเครื่องนี้แล้ว")
    end

    KeyBtn.MouseButton1Click:Connect(tryUnlock)
    KeyBox.FocusLost:Connect(function(enter) if enter then tryUnlock() end end)
    KeyBox:CaptureFocus()
end
